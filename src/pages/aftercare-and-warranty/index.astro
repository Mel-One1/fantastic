---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Prose from '../../components/Prose.astro';
import Todo from '../../components/Todo.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';

const trail = [{ name: 'Aftercare and Warranty', href: '/aftercare-and-warranty/' }];
const title = 'Aftercare and Warranty | SoftDentalCare Los Algodones';
const description =
  'What happens if something goes wrong after you travel home. Our warranty, how to reach us from the United States and who carries which cost.';
---

<BaseLayout title={title} description={description} trail={trail}>
  <Prose>
    <h1 class="text-3xl font-semibold">Aftercare and warranty</h1>
    <p>
      This page answers the question most patients do not ask out loud: what happens if there is a
      problem once you are back home in Arizona or California.
    </p>

    <h2>What the warranty covers</h2>
    <Todo needs="Warranty terms in plain words: what is covered, for how long, and what voids it. No warranty period may be invented." />

    <h2>If something goes wrong at home</h2>
    <Todo needs="The actual process: who to call, how fast we answer, whether a second trip is needed. State it honestly, even where the answer is that the patient has to travel back." />

    <h2>Who pays for what</h2>
    <Todo needs="Cost split for repairs under warranty, including whether travel costs are ever covered." />

    <h2>Looking after your implants</h2>
    <Todo needs="Aftercare instructions, approved by Dr. Garibay. No promises of success rates without a cited source." />
  </Prose>
  <RelatedLinks
    related={[
      { href: '/dental-implants/', label: 'Dental implants' },
      { href: '/faq/', label: 'Frequently asked questions' },
    ]}
  />
</BaseLayout>
