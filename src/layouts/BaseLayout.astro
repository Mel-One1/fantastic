---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbSchema, dentistSchema } from '../lib/schema';
import { site } from '../data/site';

interface Props {
  /** Full title following the pattern: Primary keyword | SoftDentalCare Los Algodones */
  title: string;
  /** 140 to 155 characters, with a call to action, no keyword stacking. */
  description: string;
  /** Breadcrumb trail, home first, current page last. */
  trail?: { name: string; href: string }[];
  /** Extra JSON-LD blocks, e.g. FAQPage or MedicalProcedure. */
  schema?: unknown[];
  noindex?: boolean;
}

const { title, description, trail = [], schema = [], noindex = false } = Astro.props;

const canonical = new URL(Astro.url.pathname, site.url).href;
const fullTrail = [{ name: 'Home', href: '/' }, ...trail];

// Nudge during development. The briefing sets 140 to 155 characters.
if (import.meta.env.DEV && (description.length < 140 || description.length > 155)) {
  console.warn(
    `[seo] ${Astro.url.pathname}: meta description is ${description.length} characters, expected 140 to 155.`,
  );
}

const jsonLd = [dentistSchema(), breadcrumbSchema(fullTrail), ...schema].filter(Boolean);
---

<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="generator" content={Astro.generator} />
    {
      jsonLd.map((entry) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />
      ))
    }
  </head>
  <body class="flex min-h-screen flex-col font-sans antialiased">
    <Header />
    <Breadcrumbs trail={fullTrail} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Click tracking for phone and WhatsApp. The analytics endpoint is not
      // wired up yet, the events are only pushed to the data layer.
      document.querySelectorAll('[data-track]').forEach((el) => {
        el.addEventListener('click', () => {
          const w = window as unknown as { dataLayer?: unknown[] };
          w.dataLayer = w.dataLayer || [];
          w.dataLayer.push({ event: 'contact_click', method: el.getAttribute('data-track') });
        });
      });
    </script>
  </body>
</html>
