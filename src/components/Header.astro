---
import { nav, site, telLink } from '../data/site';
import Todo from './Todo.astro';
const path = Astro.url.pathname;
---

<header class="border-b border-line bg-paper">
  <a
    href="#main"
    class="sr-only focus:not-sr-only focus:absolute focus:bg-accent focus:px-4 focus:py-2 focus:text-white"
  >
    Skip to content
  </a>
  <div class="mx-auto flex max-w-5xl flex-wrap items-center justify-between gap-4 px-4 py-4">
    <a href="/" class="text-lg font-semibold tracking-tight">
      {site.name}
      <span class="block text-xs font-normal text-ink-soft">Los Algodones, Mexico</span>
    </a>

    {
      telLink ? (
        <a
          href={telLink}
          data-track="call"
          class="rounded bg-accent px-4 py-2 text-sm font-semibold text-white hover:bg-accent-dark"
        >
          Call {site.telephone}
        </a>
      ) : (
        <Todo needs="Phone number for the header call button and the tel: link." />
      )
    }
  </div>

  <nav aria-label="Main" class="border-t border-line bg-sand">
    <ul class="mx-auto flex max-w-5xl flex-wrap gap-x-5 gap-y-2 px-4 py-3 text-sm">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={path === item.href ? 'page' : undefined}
              class:list={[
                'underline-offset-4 hover:underline',
                path === item.href ? 'font-semibold text-accent' : 'text-ink-soft',
              ]}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
