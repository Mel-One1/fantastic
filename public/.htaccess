# Base configuration for Hostinger (Apache and LiteSpeed both read this file).
# Generated file. Edit scripts/htaccess-head.conf, scripts/htaccess-tail.conf
# or docs/redirect-map.csv, then run: npm run redirects:htaccess

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Force https. No mixed content is allowed on this site.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # Canonical host without www.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 301 map, generated from docs/redirect-map.csv.
  RewriteRule "^index\.php/single-tooth-implant/?$" "/dental-implants/single-tooth-implant/" [R=301,L]
  RewriteRule "^index\.php/bonegraft/?$" "/dental-implants/bone-grafting/" [R=301,L]
  RewriteRule "^index\.php/contact/?$" "/contact/" [R=301,L]
  RewriteRule "^index\.php/about/?$" "/about/" [R=301,L]
  RewriteRule "^index\.php/our-work-2/?$" "/reviews/" [R=301,L]
  RewriteRule "^index\.php/dentalimplants/?$" "/dental-implants/" [R=301,L]
  RewriteRule "^index\.php/privacy-policy-2/?$" "/privacy-policy/" [R=301,L]
  RewriteRule "^index\.php/dental-implants/?$" "/dental-implants/" [R=301,L]
  RewriteRule "^index\.php/appointment/?$" "/contact/" [R=301,L]
  RewriteRule "^index\.php/price-list/?$" "/prices/" [R=301,L]
  RewriteRule "^our-work/?$" "/reviews/" [R=301,L]
  RewriteRule "^privacy-policy-2/?$" "/privacy-policy/" [R=301,L]
  # 2 further old URL(s) differ only by the trailing slash
  # and are covered by the rule below: /about, /contact

  # Trailing slash for everything else, so every URL exists in one form only.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{2,5}$
  RewriteCond %{REQUEST_URI} !/$
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # Hashed build assets never change under the same name.
  <FilesMatch "\.(css|js|woff2)$">
    ExpiresDefault "access plus 1 year"
    Header append Cache-Control "immutable"
  </FilesMatch>
  <FilesMatch "\.(avif|webp|jpg|jpeg|png|svg)$">
    ExpiresDefault "access plus 6 months"
  </FilesMatch>
  <FilesMatch "\.html$">
    ExpiresDefault "access plus 0 seconds"
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
